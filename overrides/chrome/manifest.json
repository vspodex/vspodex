{
  "manifest_version": 3,
  "name": "VspoDex",
  "description": "Track VTuber live streams via Holodex & Twitch",
  "version": "0.1.2.2",
  "key": "",
  "permissions": ["alarms", "storage", "identity"],
  "host_permissions": [
    "https://holodex.net/*",
    "https://api.twitch.tv/*",
    "https://id.twitch.tv/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png"
  },
  "action": {
    "default_title": "VspoDex",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "commands": {
    "_execute_action": {}
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  }
}
