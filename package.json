{
  "name": "vspodex",
  "version": "0.1.2.18",
  "license": "MIT",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "build:chrome": "rspack --env platform=chrome --mode=production",
    "build:firefox": "rspack --env platform=firefox --mode=production",
    "develop:chrome": "rspack --env platform=chrome --mode=development --watch",
    "develop:firefox": "rspack --env platform=firefox --mode=development --watch",
    "package:chrome": "npm run build:chrome && powershell -Command \"Compress-Archive -Path dist/chrome/* -DestinationPath vspodex-chrome.zip -Force\"",
    "test": "tsc --noEmit"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.10.8",
    "@floating-ui/react": "^0.25.0",
    "@tabler/icons-react": "^2.30.0",
    "es-toolkit": "^1.44.0",
    "overlayscrollbars": "^2.2.1",
    "overlayscrollbars-react": "^0.5.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router": "^7.6.0",
    "react-use": "^17.4.0",
    "swr": "^2.2.0",
    "webextension-polyfill": "^0.10.0"
  },
  "devDependencies": {
    "@babel/core": "^7.22.9",
    "@babel/preset-react": "^7.22.5",
    "@babel/preset-typescript": "^7.22.5",
    "@emotion/babel-plugin": "^11.10.8",
    "@rspack/cli": "^1.3.12",
    "@rspack/core": "^1.3.12",
    "@seldszar/yael": "^2.2.0",
    "@types/react": "^18.2.18",
    "@types/react-dom": "^18.2.7",
    "@types/webextension-polyfill": "^0.10.1",
    "@typescript-eslint/eslint-plugin": "^6.2.1",
    "@typescript-eslint/parser": "^6.2.1",
    "autoprefixer": "^10.4.14",
    "babel-loader": "^9.1.3",
    "babel-plugin-macros": "^3.1.0",
    "dotenv": "^16.3.1",
    "prettier": "^3.0.1",
    "tailwindcss": "^3.3.3",
    "twin.macro": "^3.4.0",
    "typescript": "^5.1.6",
    "webpack-merge": "^5.9.0"
  },
  "babelMacros": {
    "twin": {
      "preset": "emotion"
    }
  },
  "browserslist": [
    "last 2 years"
  ]
}
